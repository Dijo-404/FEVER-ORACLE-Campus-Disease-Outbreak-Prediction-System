# ================================
# FEVER ORACLE - Backend Configuration
# ================================
# Copy this file to .env and fill in your values
# Do NOT commit .env to version control!

# ================================
# Server Configuration
# ================================
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ================================
# CORS Configuration
# ================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,https://your-domain.web.app

# ================================
# Database Configuration (if using persistent storage)
# ================================
# DATABASE_URL=postgresql://user:password@localhost:5432/fever_oracle
# DATABASE_URL=mongodb://localhost:27017/fever_oracle

# ================================
# Firebase Admin SDK (for server-side auth verification)
# ================================
# Path to your Firebase service account key JSON file
# Download from Firebase Console > Project Settings > Service accounts > Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Or provide individual values:
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com

# ================================
# AI/ML Model Configuration (for outbreak predictions)
# ================================
# If using external AI services:
# OPENAI_API_KEY=sk-your-openai-api-key
# GOOGLE_AI_API_KEY=your-google-ai-api-key

# ================================
# Email Notifications (optional)
# ================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-specific-password
# NOTIFICATION_FROM_EMAIL=noreply@feveroracle.com

# ================================
# Logging
# ================================
LOG_LEVEL=INFO
